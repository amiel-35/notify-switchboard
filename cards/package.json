{
  "name": "notify-switchboard-cards",
  "version": "0.10.0",
  "private": true,
  "description": "Lovelace cards bundled with the Notify Switchboard Home Assistant integration",
  "license": "MIT",
  "author": "Amiel Lavon",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amiel-35/notify-switchboard.git",
    "directory": "cards"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "custom-card",
    "notify-switchboard"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-wc": "^2.2.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
